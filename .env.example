# ARIA local development example values. Replace before real deployment.
API_AUTH_TOKENS=dev-user-token:api-user:sre:platform,incident-commander-token:incident-commander:sre:platform
ALERTMANAGER_WEBHOOK_SECRET=replace-with-long-random-alertmanager-secret
FALCO_WEBHOOK_SECRET=replace-with-long-random-falco-secret
DATABASE_URL=postgresql+psycopg2://incident:incident@localhost:5432/incidentdb
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8000
EVENT_BUS_BACKEND=redis

# AI observability — point OTLP HTTP at self-hosted Opik or another backend.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=aria
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://opik:5173/api/v1/private/otel
OTEL_EXPORTER_OTLP_HEADERS=projectName=aria
AI_OBSERVABILITY_BACKEND=opik

# Signed ARIA -> On-Call SRE integration. Inject the shared value from a secret manager.
ON_CALL_SRE_URL=http://on-call-sre
ON_CALL_SRE_INTEGRATION_SECRET=
ON_CALL_SRE_TIMEOUT_SECONDS=5

# Optional LLM. Envoy AI Gateway is the preferred production access path.
LLM_ENABLED=false
LLM_PROVIDER=envoy-ai-gateway
LLM_TIMEOUT_SECONDS=90
AI_GATEWAY_BASE_URL=http://localhost:1975
AI_GATEWAY_MODEL=aria-reasoning
AI_GATEWAY_TENANT_ID=aria
# AI_GATEWAY_API_KEY=          # only if downstream gateway auth is enabled
# Direct Ollama is retained for explicit local/offline fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Safety defaults
CHAOS_ENABLED=false
GITOPS_PR_LIVE_ENABLED=false
HEADLAMP_BASE_URL=
