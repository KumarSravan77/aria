{
  "title": "ARIA End-to-End Application Observability",
  "uid": "aria-app-e2e",
  "schemaVersion": 39,
  "tags": ["aria", "opentelemetry", "correlation"],
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [{"name": "service", "type": "custom", "query": "checkout-api,inventory-api", "current": {"text": "checkout-api", "value": "checkout-api"}}]},
  "panels": [
    {"type": "stat", "title": "Request rate", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"$service\"}[5m]))"}], "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5}},
    {"type": "stat", "title": "Error rate", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"$service\",status_code=\"STATUS_CODE_ERROR\"}[5m])) / clamp_min(sum(rate(traces_span_metrics_calls_total{service_name=\"$service\"}[5m])), 0.001)"}], "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5}},
    {"type": "timeseries", "title": "p50/p95/p99 latency", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"$service\"}[5m])))", "legendFormat": "p50"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"$service\"}[5m])))", "legendFormat": "p95"}, {"expr": "histogram_quantile(0.99, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"$service\"}[5m])))", "legendFormat": "p99"}], "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}},
    {"type": "logs", "title": "Trace-correlated logs", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"expr": "{namespace=\"demo\"} | json | `service_name` = `$service`"}], "gridPos": {"x": 0, "y": 8, "w": 12, "h": 9}},
    {"type": "traces", "title": "Recent distributed traces", "datasource": {"type": "tempo", "uid": "tempo"}, "targets": [{"queryType": "traceql", "query": "{ resource.service.name = \"$service\" }"}], "gridPos": {"x": 12, "y": 8, "w": 12, "h": 9}}
  ]
}
